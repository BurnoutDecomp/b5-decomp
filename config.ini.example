; Copy the settings you want into config.ini beside Burnout_PC.exe, then restart.
[Display]
Width=1280
Height=720
Fullscreen=0
AdapterIndex=0
VSync=1
DecoupleSimulation=1

[Settings]
; 0 = console default (2x scene MSAA), 1 = off, 2/4/8 = requested samples.
; Unsupported counts fall back to the highest lower count supported by colour and depth.
AntiAliasing=0
AlphaToCoverage=1
EnvironmentMap=1
EnvironmentMap30Hz=1
Coronas=1
SunCorona=1

[Graphics]
; Native graphics settings. See docs/PC_GRAPHICS.md for details.
; Bloom strength: 1 = original, 0.3 = reduced, 0 = no bloom contribution.
BloomLuminanceScale=1
; Reflection world LOD: 0 = highest detail, 1 = medium, 2 = original.
EnvironmentMapLOD=2
; Traffic shadows: 0 = off, 1 = on.
TrafficShadows=0
; World texture filtering: 1 = original trilinear, 2/4/8/16 = anisotropic.
AnisotropicFiltering=1
; 1 = original 1280x1920 atlas, 2 = 2560x3840 (three vertical cascades).
ShadowResolutionScale=1
; Shadow view distance in metres, 30..500. Original: 120.
ShadowDistance=120
; Extra native caster slope bias, 0..4. Use 1 to reduce striped self-shadows.
ShadowSlopeBias=0
; 0 = original asset LODs. Extended-distance example: 3000 for both.
; Short-distance examples: 1 for world, 50 for props. Bands use distance * 1/2/3.
WorldLODOverrideDistance=0
PropLODOverrideDistance=0
; Default, Potato, Low, Medium, High, Ultra, Custom (case-insensitive).
VehicleLODPreset=Default
; Only read with VehicleLODPreset=Custom. Distances must be nondecreasing.
VehicleLOD0Distance=10
VehicleLOD1Distance=22
VehicleLOD2Distance=35
VehicleLOD3Distance=50
VehicleLOD4Distance=70
