; Copy selected settings into config.ini beside Burnout_PC.exe, then restart.
[Online]
; Leave Server empty for LAN. Set the same server and key on every player's PC.
; Example: Server=online.decomp.adriwin.fr:27900
Server=
; The server's 64-hex-digit access key. Keep your configured key out of Git.
Key=
; Optional BP_ONLINE_SERVER / BP_ONLINE_KEY environment values override these.

[SystemProfile]
; Local PC system preferences, read by XUserReadProfileSettings from this INI.
; These defaults are adopted PC policy, not recovered Xbox dashboard account data.
; 0 maps to external camera; 1/2 map to the original non-external camera preference.
RaceCameraLocation=0
; Raw controller-vibration preference (integer0..3), passed through unchanged.
ControllerVibration=3
; Missing/empty keys use0/3. Other values are an error; no partial settings are returned.

[Display]
Width=1280
Height=720
Fullscreen=0
AdapterIndex=0
VSync=1
DecoupleSimulation=1

[AdaptiveTriggers]
; Native DualSense USB/Bluetooth feedback. Restart after editing.
; Enabled=0 disables the entire feature. Existing controller vibration=0 also mutes it.
Enabled=1
; Off / Light / Standard / Immersive. Default: Immersive.
Preset=Immersive
; Overall scales, 0..100. Texture=0 silences texture/pulses; Resistance=0 mutes smooth loads.
Resistance=100
Texture=100
; Physical L2/R2 scales, 0..100, including when reversing swaps the pedal roles.
LeftStrength=100
RightStrength=100
ArcadeCues=1
; Opt-in bounded [triggers] diagnostics; default 0.
Diagnostics=0

; Per-effect tuning below preserves the default feel at 100.
; Strength: 0..200 percent; 0 disables that effect and allows lower-priority feedback.
; Frequency: 25..200 percent of the driving-dependent vibration rate (capped at 120 Hz).
; Duration: 0..200 percent for transient pulses; 0 skips the pulse.
; StartPosition: -1 keeps the default, 0..9 sets the first active travel zone.
; Takeoff only unloads the triggers: its Strength is an on/off switch.
; Hardware has discrete force steps. All input travel remains available.

PedalStrength=100
PedalStartPosition=-1

EngineStrength=100
EngineFrequency=100
EngineStartPosition=-1

LaunchStrength=100
LaunchFrequency=100
LaunchDuration=100
LaunchStartPosition=-1

ShiftStrength=100
ShiftFrequency=100
ShiftDuration=100
ShiftStartPosition=-1

LimiterStrength=100
LimiterFrequency=100
LimiterStartPosition=-1

WheelspinStrength=100
WheelspinFrequency=100
WheelspinStartPosition=-1

GripRecoveryStrength=100
GripRecoveryFrequency=100
GripRecoveryDuration=100
GripRecoveryStartPosition=-1

BoostStartStrength=100
BoostStartFrequency=100
BoostStartDuration=100
BoostStartStartPosition=-1

BoostStrength=100
BoostFrequency=100
BoostStartPosition=-1

BoostEndStrength=100
BoostEndFrequency=100
BoostEndDuration=100
BoostEndStartPosition=-1

ChainStrength=100
ChainFrequency=100
ChainDuration=100
ChainStartPosition=-1

BrakeStrength=100
BrakeStartPosition=-1

BrakeSkidStrength=100
BrakeSkidFrequency=100
BrakeSkidStartPosition=-1

DriftStartStrength=100
DriftStartFrequency=100
DriftStartDuration=100
DriftStartStartPosition=-1

DriftStrength=100
DriftFrequency=100
DriftStartPosition=-1

SurfaceStrength=100
SurfaceFrequency=100
SurfaceStartPosition=-1

TakeoffStrength=100
TakeoffDuration=100

AirborneStrength=100
AirborneFrequency=100
AirborneStartPosition=-1

LandingStrength=100
LandingFrequency=100
LandingDuration=100
LandingStartPosition=-1

ScrapeStrength=100
ScrapeFrequency=100
ScrapeStartPosition=-1

ImpactStrength=100
ImpactFrequency=100
ImpactDuration=100
ImpactStartPosition=-1

WreckStrength=100
WreckFrequency=100
WreckDuration=100
WreckStartPosition=-1

ReverseStrength=100
ReverseFrequency=100
ReverseStartPosition=-1

ShowtimeStrength=100
ShowtimeStartPosition=-1

BounceStrength=100
BounceFrequency=100
BounceDuration=100
BounceStartPosition=-1

BoostedBounceStrength=100
BoostedBounceFrequency=100
BoostedBounceDuration=100
BoostedBounceStartPosition=-1

RewardStrength=100
RewardFrequency=100
RewardDuration=100
RewardStartPosition=-1

[ControllerKeyboard]
; Optional SDL gamepad buttons/chords = keyboard keys. Restart after editing.
; R4/L4/R5/L5 name the paddles; mapped buttons replace their normal game actions.
; Uncomment an example to enable it. End also works while the assert screen is halted.
; R4=End
; Back+Start=F11
; L4=Ctrl+Shift+K

[Settings]
; 0 = console default (2x scene MSAA), 1 = off, 2/4/8 = requested samples.
AntiAliasing=0
AlphaToCoverage=1
EnvironmentMap=1
Coronas=1
SunCorona=1

[Graphics]
; Native options with no equivalent registered engine control.
AnisotropicFiltering=1
; 1 = 1280x1920 atlas, 2 = 2560x3840 when supported by the adapter.
ShadowResolutionScale=1
; Shadow view distance in metres, 30..500; original: 120.
ShadowDistance=120
; Extra native caster slope bias, 0..4; try 1 for striped self-shadows.
ShadowSlopeBias=0

[Debug]
; Pixels per cube face: 128 (original), 256, 512, 1024 or 2048. Restart after changing.
World/Reflections/Resolution (restart)=512
; Any registered writable scalar: full debug menu path/name=value.
; Paths are case-insensitive; / and backslash separators are equivalent.
; Initial values apply once after registration. Menu edits remain live.
; The reflection preset below enables the optional scene captures in Relative mode.
; Set their Enabled keys false and World/Props LOD mode Fixed for original captures.
Environment/Bloom luminance scale=1
World/LODs/Environment Map LOD=2
; Props in reflections: 0 = highest detail, 1 = intermediate, 2 = original.
World/LODs/Prop Environment Map LOD=2
; Reflection draw distance in metres, 0..10000. 0 = authored distances.
; Positive values extend world objects, props and capture frusta to at least this range.
World/LODs/Environment Map Draw Distance=0
; Optional reflection transitions. Fixed (default) retains LOD2 and the 75 m capture.
; Relative follows each category's normal LOD distances; Custom uses the metre values below.
World/Reflections/World/LOD mode=Relative
World/Reflections/World/LOD distance scale=0.5
World/Reflections/World/LOD0 distance=50
World/Reflections/World/LOD1 distance=100
World/Reflections/Props/LOD mode=Relative
World/Reflections/Props/LOD distance scale=0.5
World/Reflections/Props/LOD0 distance=50
World/Reflections/Props/LOD1 distance=100
World/ShadowMap/Cast shadows from traffic=false
World/LODs/OverrideDistances=false
World/LODs/LOD0Distance=300
World/LODs/LOD1Distance=600
World/LODs/LOD2Distance=900
World/LODs/OverridePropDistances=false
World/LODs/PropLOD0Distance=100
World/LODs/PropLOD1Distance=200
World/LODs/PropLOD2Distance=300
Graphics/Vehicles.../LODs.../Quality LOD 0=10
Graphics/Vehicles.../LODs.../Quality LOD 1=22
Graphics/Vehicles.../LODs.../Quality LOD 2=35
Graphics/Vehicles.../LODs.../Quality LOD 3=50
Graphics/Vehicles.../LODs.../Quality LOD 4=70
; false = all six faces per frame; true = alternate two groups of three faces.
World Module/Graphics/Render environment map at 30hz=false

; Optional native scene categories. Draw distance scale multiplies the normal cutoff.
World/Reflections/Backdrops/Enabled=true
World/Reflections/Backdrops/Draw distance mode=Relative
World/Reflections/Backdrops/Draw distance scale=0.5
World/Reflections/Backdrops/Draw distance=100
World/Reflections/Backdrops/LOD mode=Relative
World/Reflections/Backdrops/LOD distance scale=0.5
World/Reflections/Backdrops/Fixed LOD=2
World/Reflections/Backdrops/LOD0 distance=50
World/Reflections/Backdrops/LOD1 distance=100
World/Reflections/Traffic/Enabled=true
World/Reflections/Traffic/Draw distance mode=Relative
World/Reflections/Traffic/Draw distance scale=0.5
World/Reflections/Traffic/Draw distance=100
World/Reflections/Traffic/LOD mode=Relative
World/Reflections/Traffic/LOD distance scale=0.5
World/Reflections/Traffic/Fixed LOD=2
World/Reflections/Traffic/LOD0 distance=50
World/Reflections/Traffic/LOD1 distance=100
World/Reflections/Rivals/Enabled=true
World/Reflections/Rivals/Draw distance mode=Relative
World/Reflections/Rivals/Draw distance scale=0.5
World/Reflections/Rivals/Draw distance=100
World/Reflections/Rivals/LOD mode=Relative
World/Reflections/Rivals/LOD distance scale=0.5
World/Reflections/Rivals/Fixed LOD=2
World/Reflections/Rivals/LOD0 distance=50
World/Reflections/Rivals/LOD1 distance=100
World/Reflections/Wheels/Enabled=true
World/Reflections/Wheels/Draw distance mode=Relative
World/Reflections/Wheels/Draw distance scale=0.5
World/Reflections/Wheels/Draw distance=100
